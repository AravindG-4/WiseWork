{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Jwt": {
    "Key": "SUPABASE_JWT_SECRET",
    "Issuer": "SUPABASE_ISSUER",
    "Audience": "SUPABASE_AUDIENCE"
    //"ExpirationMinutes": 60
  },

  "Supabase": {
    "Url": "SUPABASE_URL",
    "Key": "SUPABASE_KEY"
  },

  "MongoDB": {
    "URL": "MONGODB_URL",
    "DBNAME": "DB_NAME",
    "TODO": {
      "COLLECTION": "ToDo"
    },
    "FAVOURITES": {
      "COLLECTION": "Favourites"
    }
  },

  "OpenWeather": {
    "API_KEY": "API_KEY"
  }
}
